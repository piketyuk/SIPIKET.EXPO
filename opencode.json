{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@vheins/opencode-9router@0.5.0"
  ],
  "provider": {
    "9router": {
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:ROUTER_API_KEY}"
      }
    }
  },
  "skills": {
    "paths": [
      "/root/.config/opencode/skills-repos/awesome-ai-agent-skills",
      "/root/.config/opencode/skills-repos/langgraph",
      "/root/.config/opencode/skills-repos/agent-framework",
      "/root/.config/opencode/skills-repos/llama_index",
      "/root/.config/opencode/skills-repos/agno",
      "/root/.config/opencode/skills-repos/crewAI"
    ]
  },
  "references": {
    "langgraph": {
      "path": "/root/.config/opencode/skills-repos/langgraph",
      "description": "LangGraph state graphs & agent orchestration \u2014 use for multi-step agent workflows"
    },
    "agent-framework": {
      "path": "/root/.config/opencode/skills-repos/agent-framework",
      "description": "Microsoft Agent Framework \u2014 use for agent patterns & tool calling"
    },
    "crewai": {
      "path": "/root/.config/opencode/skills-repos/crewAI",
      "description": "CrewAI roles, crews, flows \u2014 use for multi-agent collaboration"
    },
    "llama-index": {
      "path": "/root/.config/opencode/skills-repos/llama_index",
      "description": "LlamaIndex RAG, indexing, retrieval \u2014 use for data + LLM memory"
    },
    "agno": {
      "path": "/root/.config/opencode/skills-repos/agno",
      "description": "Agno agent runtime \u2014 use for agent execution & memory"
    },
    "awesome-skills": {
      "path": "/root/.config/opencode/skills-repos/awesome-ai-agent-skills",
      "description": "103 awesome agent skills \u2014 use for any agent, MCP, security, coding task"
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}